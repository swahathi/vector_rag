# Streamlit Secrets — scalable-ingestion branch
# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to Git — it is already in .gitignore.

# ── Qdrant Cloud ───────────────────────────────────────────────────────────
# Get these from https://cloud.qdrant.io → Clusters → Cluster Details & API Keys
QDRANT_URL             = "https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY         = "your-qdrant-api-key-here"
QDRANT_COLLECTION_NAME = "app_collection"

# ── Groq (LLM generation) ─────────────────────────────────────────────────
# Get a free key from https://console.groq.com
GROQ_API_KEY = "your-groq-api-key-here"
GROQ_MODEL   = "openai/gpt-oss-20b"
